# Copy to .env and fill in. NEVER commit .env — see .gitignore
# Nothing here has a default: the pipeline fails loudly rather than
# silently pointing at the wrong place.

# ---- Source ERP REST API ----
ERP_API_BASE=
ERP_API_TOKEN=
ERP_API_TOKEN_SANDBOX=

# ---- Snowflake (key-pair auth, no password) ----
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=SVC_ANALYTICS
SNOWFLAKE_PRIVATE_KEY_PATH=
